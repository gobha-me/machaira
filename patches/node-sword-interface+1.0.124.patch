+// Unlike mapVerseReference, external datasets must never silently normalize an
+// invalid key into the next book, or treat an unknown system as KJV.
+string TextProcessor::mapVersificationReference(string reference, string sourceSystem, string targetSystem)
+{
+    // SWORD systems without translation tables are deliberately unsupported:
+    // their identical-looking verse numbers can refer to different content.
+    const string supported = "|OpenBible|KJV|KJVA|NRSV|Synodal|Vulg|Calvin|DarbyFr|Segond|";
+    if (supported.find("|" + sourceSystem + "|") == string::npos ||
+        supported.find("|" + targetSystem + "|") == string::npos) return "";
+    bool sourceCanonical = sourceSystem == "OpenBible";
+    bool targetCanonical = targetSystem == "OpenBible";
+    VersificationMgr* mgr = VersificationMgr::getSystemVersificationMgr();
+    const auto* src = mgr->getVersificationSystem(sourceCanonical ? "KJV" : sourceSystem.c_str());
+    const auto* dst = mgr->getVersificationSystem(targetCanonical ? "KJV" : targetSystem.c_str());
+    if (!src || !dst) return "";
+
+    // Parse without auto-normalization, then require an exact OSIS round trip.
+    // OpenBible uses 15 verses for 3 John (KJV merges 14 and 15).
+    VerseKey key;
+    key.setVersificationSystem(sourceCanonical ? "NRSV" : sourceSystem.c_str());
+    key.setAutoNormalize(false);
+    key.setText(reference.c_str());
+    if (key.popError() || reference != key.getOSISRef() || key.getChapter() < 1 || key.getVerse() < 1) return "";
+    const char* book = key.getOSISBookName();
+    int chapter = key.getChapter(), verse = key.getVerse(), end = verse;
+    if (src->getBookNumberByOSISName(book) < 1 || dst->getBookNumberByOSISName(book) < 1) return "";
+    const auto* sourceBook = src->getBook(src->getBookNumberByOSISName(book) - 1);
+    const auto* targetBook = dst->getBook(dst->getBookNumberByOSISName(book) - 1);
+    if (!sourceBook || !targetBook) return "";
+    if (string(book) == "3John") {
+        int srcMax = sourceCanonical ? 15 : sourceBook->getVerseMax(1);
+        int dstMax = targetCanonical ? 15 : targetBook->getVerseMax(1);
+        if (verse > srcMax) return "";
+        if (srcMax == 15 && dstMax == 14 && verse == 15) verse = end = 14;
+        if (srcMax == 14 && dstMax == 15 && verse == 14) end = 15;
+    } else {
+        // OpenBible follows KJV chapter/verse numbering outside 3 John.
+        if (chapter > sourceBook->getChapterMax() || verse > sourceBook->getVerseMax(chapter)) return "";
+        src->translateVerse(dst, &book, &chapter, &verse, &end);
+        // Mapping tables use end=0 as the sentinel for a single target verse.
+        if (end == 0) end = verse;
+    }
+    if (dst->getBookNumberByOSISName(book) < 1) return "";
+    targetBook = dst->getBook(dst->getBookNumberByOSISName(book) - 1);
+    int targetMax = targetCanonical && string(book) == "3John" ? 15 :
+        (targetBook && chapter >= 1 && chapter <= targetBook->getChapterMax() ? targetBook->getVerseMax(chapter) : 0);
+    if (verse < 1 || end < verse || end > targetMax) return "";
+    stringstream result;
+    result << book << "." << chapter << "." << verse;
+    if (end > verse) result << "-" << book << "." << chapter << "." << end;
+    return result.str();
+}
