+Napi::Value NodeSwordInterface::getGenBookEntries(const Napi::CallbackInfo& info)
+{
+    lockApi();
+    INIT_SCOPE_AND_VALIDATE(ParamType::string, ParamType::number);
+    Napi::Env env = info.Env();
+    Napi::String moduleName = info[0].As<Napi::String>();
+    unsigned int limit = info[1].As<Napi::Number>().Uint32Value();
+    if (limit == 0 || limit > 100000) {
+        THROW_JS_EXCEPTION("Generic Book entry limit must be between 1 and 100000");
+    }
+
+    ASSERT_SW_MODULE_EXISTS(moduleName);
+    SWModule* swordModule = this->_moduleStore->getLocalModule(moduleName);
+    if (string(swordModule->getType()) != "Generic Books") {
+        THROW_JS_EXCEPTION("Module is not a Generic Book");
+    }
+
+    Napi::Array entries = Napi::Array::New(env);
+    swordModule->setPosition(TOP);
+    unsigned int index = 0;
+    string previousKey = "";
+    while (!swordModule->popError() && index < limit) {
+        string key = swordModule->getKeyText();
+        if (key == previousKey && index > 0) break;
+        string content = swordModule->getRawEntry();
+        Napi::Object entry = Napi::Object::New(env);
+        entry["key"] = key;
+        entry["content"] = content;
+        entries.Set(index++, entry);
+        previousKey = key;
+        swordModule->increment();
+    }
+
+    unlockApi();
+    return entries;
+}
