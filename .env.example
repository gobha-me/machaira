# Copy this file to .env, then generate a stable key with:
#   sed -i "s|^MACHAIRA_SECRET_KEY=.*|MACHAIRA_SECRET_KEY=$(openssl rand -base64 32)|" .env
# Keep the same key and machaira-data volume across restarts.
MACHAIRA_SECRET_KEY=

# Application image and published address.
MACHAIRA_IMAGE=ghcr.io/gobha-me/machaira
MACHAIRA_VERSION=0.14.0
MACHAIRA_BIND_ADDRESS=127.0.0.1
MACHAIRA_PORT=5274

# CPU-first inference defaults shared with the Helm chart.
MACHAIRA_EMBEDDING_MODEL=all-minilm:22m
MACHAIRA_EMBEDDING_BATCH_SIZE=16
MACHAIRA_STT_MODEL=Systran/faster-whisper-small
MACHAIRA_TTS_MODEL=kokoro
MACHAIRA_TTS_VOICE=af_heart

# Optional: make a profile persistent instead of selecting it per command.
# COMPOSE_PROFILES=easy

# Optional: auto-register private, externally managed endpoints in app-only mode.
# Keep credentials in per-user Settings, not in this descriptor.
# MACHAIRA_DEPLOYMENT_PROVIDERS_JSON={"embeddings":{"source":"external","engine":"openai-compatible","baseUrl":"http://host.docker.internal:11434/v1","model":"all-minilm:22m","batchSize":16}}
